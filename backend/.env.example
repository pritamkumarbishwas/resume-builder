# ============================================
# Chat AI - Environment Variables
# ============================================

# --- App ---
APP_NAME=Chat AI Backend
DEBUG=false

# --- LLM Provider ---
# Options: "mock", "openai", "groq"
LLM_PROVIDER=groq

# --- Groq API ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# --- OpenAI (optional, use if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# --- Qdrant Vector DB ---
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=chat_ai

# --- Embedding Model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","https://chat-ai-f3n9-eight.vercel.app"]

MONGO_URI=your_mongodb_uri_here
